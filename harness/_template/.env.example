# =============================================================================
# AEGIRA Agent-Operating-Model Harness — Environment configuration
# =============================================================================
# Copy this file to .env and fill in real values. Never commit .env.

# -----------------------------------------------------------------------------
# REQUIRED — LLM provider
# -----------------------------------------------------------------------------
# Option A: Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Option B: use claude auth login instead (no key needed)
# LLM_PROVIDER=anthropic       # default
# LLM_MODEL=claude-sonnet-4-6  # default

# -----------------------------------------------------------------------------
# OPTIONAL — GitHub-PAT-MCP (only if MCP-Server is connected)
# -----------------------------------------------------------------------------
GITHUB_TOKEN=github_pat_...
GITHUB_DEFAULT_OWNER=exmachinai
GITHUB_PROTECTED_PATHS=00_CLAUDE_KNOWLEDGE_ARCHITECTURE/**

# -----------------------------------------------------------------------------
# OPTIONAL — HITL notifications
# -----------------------------------------------------------------------------
HITL_NOTIFY_SLACK_WEBHOOK=
HITL_NOTIFY_EMAIL=
HITL_NOTIFY_TEAMS_WEBHOOK=
HITL_LANG=de

# -----------------------------------------------------------------------------
# OPTIONAL — Run controls
# -----------------------------------------------------------------------------
MAX_TOKENS_PER_RUN=1000000
HARNESS_HOME=.harness/
LOG_LEVEL=info
