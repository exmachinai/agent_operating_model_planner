# =============================================================================
# github-pat-mcp-server — Environment configuration
# =============================================================================
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# -----------------------------------------------------------------------------
# REQUIRED — GitHub Fine-Grained Personal Access Token
# -----------------------------------------------------------------------------
# Create at: https://github.com/settings/personal-access-tokens/new
#
# Minimum permissions (Repository access: "All repositories" or specific repos):
#   Repository permissions:
#     - Administration:   Read and write  (for github_create_repo)
#     - Contents:         Read and write  (for read_file, write_file)
#     - Issues:           Read and write
#     - Metadata:         Read            (always required)
#     - Pull requests:    Read and write
#   Account permissions:
#     - (none required)
#
# Expiration: maximum 90 days recommended.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# OPTIONAL — Default owner used when tools are called without `owner` parameter
# -----------------------------------------------------------------------------
GITHUB_DEFAULT_OWNER=exmachinai

# -----------------------------------------------------------------------------
# OPTIONAL — Constitution-Safety-Guard
# -----------------------------------------------------------------------------
# Comma-separated glob patterns. Writes (write_file, create/update_issue,
# create_pull_request) targeting paths or repos matching these patterns are
# REFUSED unless the caller passes `acknowledge_protected_path: true` plus a
# `protected_path_reason` justification.
#
# Default protects the AEGIRA Knowledge Architecture canonical zone.
GITHUB_PROTECTED_PATHS=00_CLAUDE_KNOWLEDGE_ARCHITECTURE/**,**/00_CLAUDE_KNOWLEDGE_ARCHITECTURE/**

# -----------------------------------------------------------------------------
# OPTIONAL — Server behavior
# -----------------------------------------------------------------------------
# Max characters returned per tool call (truncation threshold). Default: 25000.
# CHARACTER_LIMIT=25000

# Request timeout in milliseconds. Default: 30000.
# GITHUB_TIMEOUT_MS=30000

# Log level: error | warn | info | debug. Logged to stderr only. Default: info.
# LOG_LEVEL=info
