{
  "name": "github-pat-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for GitHub via Fine-Grained Personal Access Token. Works locally without OAuth.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "github-pat-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@octokit/rest": "^21.0.2",
    "@octokit/request-error": "^6.1.5",
    "minimatch": "^10.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "mcp",
    "github",
    "model-context-protocol",
    "claude",
    "cowork",
    "aegira"
  ],
  "author": "exmachinAI GmbH",
  "license": "Apache-2.0",
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    ".env.example"
  ]
}
